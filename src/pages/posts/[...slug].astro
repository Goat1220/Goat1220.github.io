---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { CATEGORIES } from '../../categories';
import { getPosts } from '../../posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) => d.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base title={post.data.title} description={post.data.description} image={post.data.image}>
  <article>
    <header class="post-header">
      <div class="meta">
        <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
        <a class="category" href={`/category/${post.data.category}/`}>{CATEGORIES[post.data.category].name}</a>
        {post.data.draft && <span class="draft-badge">초안</span>}
        {post.data.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
      <h1>{post.data.title}</h1>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
