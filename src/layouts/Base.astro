---
import '../styles/global.css';
import { CATEGORIES, CATEGORY_KEYS } from '../categories';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const siteTitle = '기획자의 개발일지';
const { title, description = '게임 기획자가 직접 게임을 만들며 남기는 기획과 개발 기록', image = '/og.png' } = Astro.props;
const pageTitle = title ? `${title} | ${siteTitle}` : siteTitle;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/galmuri/dist/galmuri.css" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="logo" href="/"><img src="/icon.png" alt="" />{siteTitle}</a>
        <nav class="site-nav">
          <a href="/" aria-current={path === '/' ? 'page' : undefined}>전체</a>
          {CATEGORY_KEYS.map((key) => (
            <a href={`/category/${key}/`} aria-current={path.startsWith(`/category/${key}`) ? 'page' : undefined}>{CATEGORIES[key].name}</a>
          ))}
          <a href="/about/" aria-current={path.startsWith('/about') ? 'page' : undefined}>소개</a>
        </nav>
      </div>
    </header>
    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="wrap">© {new Date().getFullYear()} Goat1220</div>
    </footer>
  </body>
</html>
