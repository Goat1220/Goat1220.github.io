---
import type { CollectionEntry } from 'astro:content';
import { CATEGORIES } from '../categories';

interface Props {
  posts: CollectionEntry<'posts'>[];
  showCategory?: boolean;
}

const { posts, showCategory = true } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' });
---

{posts.length === 0 ? (
  <p class="empty">아직 글이 없습니다. 곧 첫 글이 올라옵니다.</p>
) : (
  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <a class="post-card" href={`/posts/${post.id}/`}>
          <div class="meta">
            <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
            {showCategory && <span class="category">{CATEGORIES[post.data.category].name}</span>}
            {post.data.draft && <span class="draft-badge">초안</span>}
            {post.data.tags.map((t) => <span class="tag">{t}</span>)}
          </div>
          <h2>{post.data.title}</h2>
          <p>{post.data.description}</p>
        </a>
      </li>
    ))}
  </ul>
)}
